---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";

const themeLabel = i18n(I18nKey.themeColor);
---

<div id="display-setting" class="float-panel float-panel-closed absolute transition-all w-80 right-4 px-4 py-4">
    <div class="flex flex-row gap-2 mb-3 items-center justify-between">
        <div class="flex gap-2 font-bold text-lg text-neutral-900 dark:text-neutral-100 transition relative ml-3
            before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:-left-3 before:top-[0.33rem]"
        >
            {themeLabel}
            <button aria-label="Reset to Default" class="btn-regular w-7 h-7 rounded-md  active:scale-90 will-change-transform"
                    id="hue-reset">
                <div class="text-[var(--btn-content)]">
                    <Icon name="fa6-solid:arrow-rotate-left" class="text-[0.875rem]" />
                </div>
            </button>
        </div>
        <div class="flex gap-1">
            <div id="hueValue" class="transition bg-[var(--btn-regular-bg)] w-10 h-7 rounded-md flex justify-center
            font-bold text-sm items-center text-[var(--btn-content)]">
            </div>
        </div>
    </div>
    <div class="w-full h-6 px-1 bg-[oklch(0.80_0.10_0)] dark:bg-[oklch(0.70_0.10_0)] rounded select-none">
        <input aria-label={themeLabel} type="range" min="0" max="360"
               class="slider" id="colorSlider" step="5" style="width: 100%" value="250" />
    </div>
</div>

<!-- pre-paint sync from stored hue -->
<script is:inline>
	(() => {
		const stored = localStorage.getItem("hue");
		const carrier = document.getElementById("config-carrier");
		const def = Number.parseInt(carrier?.dataset.hue || "250", 10);
		const hue = stored ? Number.parseInt(stored, 10) : def;
		const slider = document.getElementById("colorSlider");
		if (slider) slider.value = String(hue);
		const shown = document.getElementById("hueValue");
		if (shown) shown.textContent = String(hue);
		const reset = document.getElementById("hue-reset");
		if (reset) {
			reset.classList.toggle("opacity-0", hue === def);
			reset.classList.toggle("pointer-events-none", hue === def);
		}
	})();
</script>

<script>
	import { getDefaultHue, getHue, setHue } from "@utils/setting-utils";

	function refreshUI() {
		const hue = getHue();
		const defaultHue = getDefaultHue();
		const slider = document.getElementById("colorSlider") as HTMLInputElement | null;
		if (slider) slider.value = String(hue);
		const shown = document.getElementById("hueValue");
		if (shown) shown.textContent = String(hue);
		const reset = document.getElementById("hue-reset");
		if (reset) {
			reset.classList.toggle("opacity-0", hue === defaultHue);
			reset.classList.toggle("pointer-events-none", hue === defaultHue);
		}
	}

	function bind() {
		const slider = document.getElementById("colorSlider");
		if (slider && !slider.dataset.bound) {
			slider.dataset.bound = "1";
			slider.addEventListener("input", () => {
				setHue(Number.parseInt((slider as HTMLInputElement).value, 10));
				refreshUI();
			});
		}
		const reset = document.getElementById("hue-reset");
		if (reset && !reset.dataset.bound) {
			reset.dataset.bound = "1";
			reset.addEventListener("click", () => {
				setHue(getDefaultHue());
				refreshUI();
			});
		}
	}

	bind();
	refreshUI();
	document.addEventListener("astro:page-load", () => {
		bind();
		refreshUI();
	});
</script>

<style>
	#display-setting input[type="range"] {
		-webkit-appearance: none;
		height: 1.5rem;
		background-image: var(--color-selection-bar);
		transition: background-image 0.15s ease-in-out;
	}

	/* Input Thumb */
	#display-setting input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		height: 1rem;
		width: 0.5rem;
		border-radius: 0.125rem;
		background: rgba(255, 255, 255, 0.7);
		box-shadow: none;
	}
	#display-setting input[type="range"]::-webkit-slider-thumb:hover {
		background: rgba(255, 255, 255, 0.8);
	}
	#display-setting input[type="range"]::-webkit-slider-thumb:active {
		background: rgba(255, 255, 255, 0.6);
	}

	#display-setting input[type="range"]::-moz-range-thumb {
		appearance: none;
		height: 1rem;
		width: 0.5rem;
		border-radius: 0.125rem;
		border-width: 0;
		background: rgba(255, 255, 255, 0.7);
		box-shadow: none;
	}
	#display-setting input[type="range"]::-moz-range-thumb:hover {
		background: rgba(255, 255, 255, 0.8);
	}
	#display-setting input[type="range"]::-moz-range-thumb:active {
		background: rgba(255, 255, 255, 0.6);
	}
</style>
